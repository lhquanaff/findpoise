---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import VerdictBadge from '@/components/affiliate/VerdictBadge.astro';

export interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      publishDate: Date;
      productA: {
        name: string;
        brand: string;
        image: string;
        price: number;
        rating: number;
        affiliateUrl: string;
        pros: string[];
        badge?: string;
      };
      productB: {
        name: string;
        brand: string;
        image: string;
        price: number;
        rating: number;
        affiliateUrl: string;
        pros: string[];
        badge?: string;
      };
      winner: string;
      verdict: string;
    };
  };
}

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout
  title={data.title}
  description={data.description}
  articleType="article"
  publishDate={data.publishDate}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Comparisons', url: '/compare' },
        { name: `${data.productA.name} vs ${data.productB.name}`, url: `/compare/${entry.id}` },
      ]}
    />

    <!-- Header Section -->
    <header class="my-6 text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold tracking-wide uppercase">
        <span>Head-to-Head Showdown</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {data.title}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">{data.description}</p>
    </header>

    <!-- Side-by-Side Winner Box -->
    <div class="my-8 rounded-2xl border-2 border-emerald-500/40 bg-gradient-to-b from-emerald-50/50 via-white to-white p-6 sm:p-8 shadow-card">
      <div class="text-center mb-6">
        <VerdictBadge type="winner" text={`Winner: ${data.winner}`} />
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-3">Overall Verdict</h3>
        <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto mt-2 leading-relaxed">
          {data.verdict}
        </p>
      </div>

      <!-- Quick Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-200">
        <!-- Product A Card -->
        <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{data.productA.brand}</span>
            {data.winner === data.productA.name && <span class="badge-winner">Winner</span>}
          </div>
          <h4 class="text-lg font-bold text-slate-900">{data.productA.name}</h4>
          <div class="text-2xl font-extrabold text-slate-900">${data.productA.price.toFixed(2)}</div>
          <ul class="space-y-1.5 text-xs text-slate-600">
            {data.productA.pros.slice(0, 3).map((p) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a
            href={data.productA.affiliateUrl}
            target="_blank"
            rel="nofollow noopener sponsored"
            class="inline-flex w-full items-center justify-center px-4 py-2.5 text-xs font-bold text-white bg-slate-900 hover:bg-emerald-600 rounded-xl transition-colors shadow-sm"
          >
            Check {data.productA.name} Price
          </a>
        </div>

        <!-- Product B Card -->
        <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{data.productB.brand}</span>
            {data.winner === data.productB.name && <span class="badge-winner">Winner</span>}
          </div>
          <h4 class="text-lg font-bold text-slate-900">{data.productB.name}</h4>
          <div class="text-2xl font-extrabold text-slate-900">${data.productB.price.toFixed(2)}</div>
          <ul class="space-y-1.5 text-xs text-slate-600">
            {data.productB.pros.slice(0, 3).map((p) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a
            href={data.productB.affiliateUrl}
            target="_blank"
            rel="nofollow noopener sponsored"
            class="inline-flex w-full items-center justify-center px-4 py-2.5 text-xs font-bold text-white bg-slate-900 hover:bg-emerald-600 rounded-xl transition-colors shadow-sm"
          >
            Check {data.productB.name} Price
          </a>
        </div>
      </div>
    </div>

    <!-- Main Comparison Analysis Slot -->
    <div class="prose prose-slate prose-lg max-w-none my-10 prose-headings:font-extrabold prose-headings:tracking-tight prose-a:text-emerald-600">
      <slot />
    </div>
  </article>
</BaseLayout>
