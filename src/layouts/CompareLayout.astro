---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import VerdictBadge from '@/components/affiliate/VerdictBadge.astro';

export interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      publishDate: Date;
      productA: {
        name: string;
        brand: string;
        image: string;
        price: number;
        rating: number;
        affiliateUrl: string;
        pros: string[];
        badge?: string;
      };
      productB: {
        name: string;
        brand: string;
        image: string;
        price: number;
        rating: number;
        affiliateUrl: string;
        pros: string[];
        badge?: string;
      };
      winner: string;
      verdict: string;
    };
  };
}

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout
  title={data.title}
  description={data.description}
  articleType="article"
  publishDate={data.publishDate}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Comparisons', url: '/compare' },
        { name: `${data.productA.name} vs ${data.productB.name}`, url: `/compare/${entry.id}` },
      ]}
    />

    <!-- Header Section -->
    <header class="my-8 text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-300/80 text-xs font-bold tracking-wider uppercase shadow-subtle">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Head-to-Head Hardware Showdown</span>
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
        {data.title}
      </h1>
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">{data.description}</p>
    </header>

    <!-- Side-by-Side Winner Box -->
    <div class="my-10 rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-card ring-1 ring-black/[0.02]">
      <div class="text-center mb-8 pb-6 border-b border-slate-100">
        <VerdictBadge type="winner" text={`Definitive Winner: ${data.winner}`} />
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight mt-4">The Verdict</h3>
        <p class="text-sm sm:text-base text-slate-700 max-w-2xl mx-auto mt-2 leading-relaxed">
          {data.verdict}
        </p>
      </div>

      <!-- Quick Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Product A Card -->
        <div class={`rounded-xl border p-6 space-y-4 transition-all ${
          data.winner === data.productA.name 
            ? 'border-emerald-300 bg-emerald-50/30 shadow-subtle ring-1 ring-emerald-500/20' 
            : 'border-slate-200/80 bg-slate-50/50'
        }`}>
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase font-bold tracking-wider text-slate-500">{data.productA.brand}</span>
            {data.winner === data.productA.name && (
              <span class="badge-winner">Winner</span>
            )}
          </div>
          <h4 class="text-xl font-extrabold text-slate-950 tracking-tight">{data.productA.name}</h4>
          <div class="text-3xl font-extrabold text-slate-950">${data.productA.price.toFixed(2)}</div>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
            {data.productA.pros.slice(0, 3).map((p) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a
            href={data.productA.affiliateUrl}
            target="_blank"
            rel="nofollow noopener sponsored"
            class="inline-flex w-full items-center justify-center px-4 py-3 text-xs font-bold text-white bg-slate-950 hover:bg-emerald-700 rounded-xl transition-all shadow-subtle hover:shadow-card hover:-translate-y-0.5 active:translate-y-0"
          >
            Check {data.productA.name} Price
          </a>
        </div>

        <!-- Product B Card -->
        <div class={`rounded-xl border p-6 space-y-4 transition-all ${
          data.winner === data.productB.name 
            ? 'border-emerald-300 bg-emerald-50/30 shadow-subtle ring-1 ring-emerald-500/20' 
            : 'border-slate-200/80 bg-slate-50/50'
        }`}>
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase font-bold tracking-wider text-slate-500">{data.productB.brand}</span>
            {data.winner === data.productB.name && (
              <span class="badge-winner">Winner</span>
            )}
          </div>
          <h4 class="text-xl font-extrabold text-slate-950 tracking-tight">{data.productB.name}</h4>
          <div class="text-3xl font-extrabold text-slate-950">${data.productB.price.toFixed(2)}</div>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
            {data.productB.pros.slice(0, 3).map((p) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <a
            href={data.productB.affiliateUrl}
            target="_blank"
            rel="nofollow noopener sponsored"
            class="inline-flex w-full items-center justify-center px-4 py-3 text-xs font-bold text-white bg-slate-950 hover:bg-emerald-700 rounded-xl transition-all shadow-subtle hover:shadow-card hover:-translate-y-0.5 active:translate-y-0"
          >
            Check {data.productB.name} Price
          </a>
        </div>
      </div>
    </div>

    <!-- Main Comparison Analysis Slot -->
    <div class="prose prose-slate prose-lg max-w-none my-12 prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-950 prose-p:text-slate-700 prose-p:leading-relaxed prose-a:text-emerald-700 prose-a:font-semibold prose-a:underline hover:prose-a:text-emerald-800 prose-img:rounded-2xl">
      <slot />
    </div>
  </article>
</BaseLayout>

