---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import AffiliateCTA from '@/components/affiliate/AffiliateCTA.astro';
import ProsConsBox from '@/components/affiliate/ProsConsBox.astro';
import QuickVerdictBox from '@/components/affiliate/QuickVerdictBox.astro';
import RedditConsensusBox from '@/components/affiliate/RedditConsensusBox.astro';
import JsonLd from '@/components/seo/JsonLd.astro';

export interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      productName: string;
      brand: string;
      category: string;
      price: number;
      rating: number;
      publishDate: Date;
      updatedDate?: Date;
      author: string;
      heroImage: string;
      affiliateUrl: string;
      retailer: string;
      couponCode?: string;
      discount?: string;
      verdict: string;
      pros: string[];
      cons: string[];
      specs?: Record<string, string>;
      benchmarks?: {
        wobbleScoreAt45?: number;
        noiseDecibels?: number;
        realWorldPayloadLbs?: number;
        assemblyTimeMinutes?: number;
      };
      redditSentiment?: {
        consensus: string;
        topComplaint: string;
        communityThreadUrl?: string;
        threadCountAnalyzed?: number;
      };
    };
  };
}

const { entry } = Astro.props;
const { data } = entry;

// Generate Schema.org Product + Review JSON-LD
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.productName,
  brand: {
    '@type': 'Brand',
    name: data.brand,
  },
  offers: {
    '@type': 'Offer',
    price: data.price,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: data.affiliateUrl,
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: data.rating,
      bestRating: '5',
      worstRating: '1',
    },
    author: {
      '@type': 'Person',
      name: data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: 'FindPoise',
      url: 'https://findpoise.com',
    },
    datePublished: data.publishDate.toISOString(),
    reviewBody: data.verdict,
  },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  articleType="article"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  author={data.author}
>
  <JsonLd data={reviewSchema} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Reviews', url: '/reviews' },
        { name: data.productName, url: `/reviews/${entry.id}` },
      ]}
    />

    <!-- Header Section -->
    <header class="my-8 space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-300/80 text-xs font-bold tracking-wider uppercase shadow-subtle">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Lab Review: {data.category.replace('-', ' ')}</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
        {data.title}
      </h1>
      
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">{data.description}</p>

      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-slate-500 pt-4 border-t border-slate-200/80">
        <span class="flex items-center gap-1.5">
          <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-[10px]">FP</span>
          <span>By <strong class="text-slate-900 font-semibold">{data.author}</strong></span>
        </span>
        <span class="text-slate-300">•</span>
        <time datetime={data.publishDate.toISOString()} class="text-slate-600">
          Updated {data.updatedDate ? data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
        <span class="text-slate-300">•</span>
        <span class="text-slate-600">Spec-Tested Hardware</span>
      </div>
    </header>

    <!-- Top Affiliate CTA Box -->
    <AffiliateCTA
      productName={data.productName}
      brand={data.brand}
      price={data.price}
      rating={data.rating}
      affiliateUrl={data.affiliateUrl}
      retailer={data.retailer}
      couponCode={data.couponCode}
      badge="Editor's Choice"
    />

    <!-- AEO / GEO Quick Verdict Callout -->
    <QuickVerdictBox
      productName={data.productName}
      verdict={data.verdict}
      rating={data.rating}
      benchmarks={data.benchmarks}
      affiliateUrl={data.affiliateUrl}
    />

    <!-- Pros & Cons Component -->
    <ProsConsBox pros={data.pros} cons={data.cons} productName={data.productName} />

    <!-- Reddit Community Consensus (E-E-A-T Friction & Fact-Check) -->
    {data.redditSentiment && (
      <RedditConsensusBox
        productName={data.productName}
        consensus={data.redditSentiment.consensus}
        topComplaint={data.redditSentiment.topComplaint}
        communityThreadUrl={data.redditSentiment.communityThreadUrl}
        threadCountAnalyzed={data.redditSentiment.threadCountAnalyzed}
      />
    )}

    <!-- Technical Specs Table (if provided) -->
    {data.specs && (
      <div class="my-10 rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-card">
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-slate-100">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <h3 class="text-lg sm:text-xl font-extrabold text-slate-950 tracking-tight">Verified Technical Specifications</h3>
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
          {Object.entries(data.specs).map(([key, val]) => (
            <div class="flex justify-between py-2 border-b border-slate-100/80">
              <dt class="font-medium text-slate-500">{key}</dt>
              <dd class="font-bold text-slate-900 text-right">{val}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <!-- Prose Content -->
    <div class="prose prose-slate prose-lg max-w-none my-12 prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-950 prose-p:text-slate-700 prose-p:leading-relaxed prose-a:text-emerald-700 prose-a:font-semibold prose-a:underline hover:prose-a:text-emerald-800 prose-img:rounded-2xl prose-img:shadow-card">
      <slot />
    </div>

    <!-- Bottom Affiliate CTA Box -->
    <div class="mt-14 pt-8 border-t border-slate-200">
      <div class="text-xs uppercase font-bold tracking-wider text-slate-400 mb-2">Final Recommendation</div>
      <AffiliateCTA
        productName={data.productName}
        brand={data.brand}
        price={data.price}
        rating={data.rating}
        affiliateUrl={data.affiliateUrl}
        retailer={data.retailer}
        couponCode={data.couponCode}
        badge="Best Deal Today"
      />
    </div>
  </article>
</BaseLayout>
