---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Build schema BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://findpoise.com',
    },
    ...items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: item.name,
      item: new URL(item.url, Astro.site || 'https://findpoise.com').href,
    })),
  ],
};
---

<nav aria-label="Breadcrumb" class="py-3 text-xs text-slate-500">
  <ol class="flex items-center flex-wrap gap-1.5">
    <li>
      <a href="/" class="hover:text-emerald-600 transition-colors">Home</a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          <span class="text-slate-400">/</span>
          {isLast ? (
            <span class="text-slate-800 font-semibold truncate max-w-[240px] sm:max-w-md" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-emerald-600 transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
