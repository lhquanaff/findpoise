---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Col 1: Brand & Mission -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M4 8h16M12 8v12M8 20h8"/>
            </svg>
          </div>
          <span class="font-display font-extrabold text-xl text-white tracking-tight">Find<span class="text-emerald-400">Poise</span></span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          Independent, spec-driven reviews and head-to-head comparisons for modern workstations, standing desks, and ergonomic chairs.
        </p>
        <p class="text-xs text-slate-400 font-medium">
          Elevate your posture. Find your poise.
        </p>
      </div>

      <!-- Col 2: Categories -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Categories</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Standing Desks</a></li>
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Ergonomic Chairs</a></li>
          <li><a href="/compare" class="hover:text-emerald-400 transition-colors">Head-to-Head Comparisons</a></li>
          <li><a href="/coupons" class="hover:text-emerald-400 transition-colors">Verified Brand Coupons</a></li>
          <li><a href="/guides" class="hover:text-emerald-400 transition-colors">Ergonomic Setup Guides</a></li>
        </ul>
      </div>

      <!-- Col 3: Popular Brands -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Top Brands</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">FlexiSpot Standing Desks</a></li>
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Uplift Desk Showdowns</a></li>
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Secretlab Titan & Magnus</a></li>
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Herman Miller Ergonomics</a></li>
          <li><a href="/reviews" class="hover:text-emerald-400 transition-colors">Branch Ergonomic Chairs</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Trust -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Editorial & Legal</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/affiliate-disclosure" class="hover:text-emerald-400 transition-colors">Affiliate Disclosure (FTC)</a></li>
          <li><a href="/privacy-policy" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact Editorial Team</a></li>
        </ul>
      </div>
    </div>

    <!-- Mandatory FTC Affiliate Disclosure Notice -->
    <div class="mt-12 pt-8 border-t border-slate-900 text-xs leading-relaxed text-slate-400 space-y-3">
      <p>
        <strong class="text-slate-300">Affiliate Disclosure:</strong> FindPoise is an independent review platform. We participate in various affiliate marketing programs (including Impact Radius, ShareASale, CJ, and Amazon Services LLC Associates Program). This means we may earn a small referral commission at no additional cost to you when you make a purchase through our links. Our evaluations are strictly based on objective technical specifications, community consensus (Reddit, tech forums), and hands-on ergonomic testing.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-slate-900/60 text-slate-400">
        <p>&copy; {currentYear} FindPoise.com. All rights reserved.</p>
        <p class="text-[11px]">Crafted for posture perfection & peak cognitive performance.</p>
      </div>
    </div>
  </div>
</footer>
