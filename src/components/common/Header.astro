---
const navLinks = [
  { label: 'Reviews', href: '/reviews' },
  { label: 'Comparisons', href: '/compare' },
  { label: 'Buying Guides', href: '/guides' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <!-- Sitewide Affiliate Micro-Disclosure -->
  <div class="bg-slate-900 py-1.5 px-4 text-center text-xs text-slate-300">
    <span class="inline-flex items-center gap-1.5">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span>Reader-supported: When you buy through links on our site, we may earn an affiliate commission.</span>
      <a href="/affiliate-disclosure" class="underline hover:text-white transition-colors">Learn more</a>
    </span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-slate-900 flex items-center justify-center text-emerald-400 group-hover:bg-slate-800 transition-colors shadow-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h16M12 8v12M8 20h8"/>
            <circle cx="12" cy="4" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-xl text-slate-900 tracking-tight leading-none">Find<span class="text-emerald-600">Poise</span></span>
          <span class="text-[10px] uppercase font-bold tracking-widest text-slate-600">Workstation Ergonomics</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-semibold rounded-lg transition-colors ${
                isActive
                  ? 'text-emerald-700 bg-emerald-50'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/compare"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
        >
          <span>Versus Matrix</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>
