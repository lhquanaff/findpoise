---
const navLinks = [
  { label: 'Reviews', href: '/reviews', description: 'Spec-tested ergonomic evaluations' },
  { label: 'Comparisons', href: '/compare', description: 'Head-to-head versus showdowns' },
  { label: 'Buying Guides', href: '/guides', description: 'Posture, height & biomechanics' },
  { label: 'Deals & Coupons', href: '/coupons', description: 'Verified manufacturer promo codes' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/85 backdrop-blur-md transition-all">
  <!-- Sitewide Affiliate Micro-Disclosure -->
  <div class="bg-slate-950 py-1.5 px-4 text-center text-xs text-slate-300 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-medium text-slate-300">Reader-Supported Ergonomics Lab: We test hardware independently. Purchases may earn a commission.</span>
      <a href="/affiliate-disclosure" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2 transition-colors font-semibold ml-1">FTC Policy</a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="FindPoise Homepage">
        <div class="w-10 h-10 rounded-xl bg-slate-950 flex items-center justify-center text-emerald-400 group-hover:bg-slate-900 group-hover:text-emerald-300 transition-all duration-200 shadow-sm ring-1 ring-white/10 group-hover:shadow-glow-emerald">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h16M12 8v12M8 20h8"/>
            <circle cx="12" cy="4" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="font-display font-extrabold text-xl sm:text-2xl text-slate-950 tracking-tight leading-none group-hover:text-slate-800 transition-colors">
            Find<span class="text-emerald-700">Poise</span>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-widest text-slate-500 mt-1">Workstation Ergonomics Lab</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-semibold rounded-lg transition-all duration-150 ${
                isActive
                  ? 'text-emerald-900 bg-emerald-50/90 shadow-subtle'
                  : 'text-slate-600 hover:text-slate-950 hover:bg-slate-100/80'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTA & Mobile Trigger -->
      <div class="flex items-center gap-3">
        <a
          href="/compare"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-800 bg-slate-100/90 hover:bg-slate-200/90 border border-slate-200/80 rounded-xl transition-all shadow-subtle hover:shadow-card hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Versus Matrix</span>
          <svg class="w-3.5 h-3.5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>

        <!-- Mobile Menu Hamburger Button -->
        <button
          type="button"
          id="mobile-nav-toggle"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-slate-700 hover:text-slate-950 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-600"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="18" x2="20" y2="18"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-nav-drawer" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2 shadow-card">
    <div class="space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`flex flex-col p-3 rounded-xl transition-colors ${
              isActive
                ? 'bg-emerald-50 text-emerald-900 font-bold'
                : 'text-slate-700 hover:bg-slate-50 font-medium'
            }`}
          >
            <span class="text-sm font-semibold">{link.label}</span>
            <span class="text-xs text-slate-500">{link.description}</span>
          </a>
        );
      })}
    </div>

    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a
        href="/compare"
        class="flex items-center justify-center gap-2 w-full py-2.5 text-xs font-bold uppercase tracking-wider text-slate-900 bg-slate-100 rounded-xl"
      >
        <span>Open Versus Matrix</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </a>
      <a
        href="/affiliate-disclosure"
        class="text-center text-xs text-slate-500 hover:text-slate-800 py-1"
      >
        Editorial Integrity & FTC Disclosure
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (toggleBtn && drawer && hamburgerIcon && closeIcon) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        drawer.classList.toggle('hidden');
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

