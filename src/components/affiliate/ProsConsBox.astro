---
export interface Props {
  pros: string[];
  cons: string[];
  productName?: string;
}

const { pros, cons, productName } = Astro.props;
---

<div class="my-10 rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-card">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-4">
    <div>
      <h3 class="text-xl font-extrabold text-slate-950 tracking-tight flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
        <span>{productName ? `${productName}: Key Strengths & Watchouts` : 'Strengths & Critical Watchouts'}</span>
      </h3>
      <p class="text-xs text-slate-500 mt-1">Based on mechanical stress testing, motor analysis & verified long-term owner feedback</p>
    </div>
    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 self-start sm:self-auto">Objective Audit</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Pros Column -->
    <div class="rounded-xl bg-emerald-50/60 border border-emerald-200/80 p-5 sm:p-6 space-y-3">
      <div class="flex items-center gap-2 text-emerald-900 font-extrabold text-sm uppercase tracking-wider">
        <div class="w-5 h-5 rounded-full bg-emerald-200/80 text-emerald-800 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <span>What Stood Out (Pros)</span>
      </div>
      <ul class="space-y-3">
        {pros.map((pro) => (
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-snug">
            <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
            <span>{pro}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cons Column -->
    <div class="rounded-xl bg-rose-50/50 border border-rose-200/70 p-5 sm:p-6 space-y-3">
      <div class="flex items-center gap-2 text-rose-950 font-extrabold text-sm uppercase tracking-wider">
        <div class="w-5 h-5 rounded-full bg-rose-200/80 text-rose-800 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </div>
        <span>Critical Watchouts (Cons)</span>
      </div>
      <ul class="space-y-3">
        {cons.map((con) => (
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 leading-snug">
            <span class="text-rose-600 font-bold shrink-0 mt-0.5">✕</span>
            <span>{con}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

