---
export interface Props {
  pros: string[];
  cons: string[];
  productName?: string;
}

const { pros, cons, productName } = Astro.props;
---

<div class="my-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4">
    <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
      <span class="text-emerald-500">⚖️</span>
      <span>{productName ? `${productName}: The Good & The Bad` : 'Pros & Cons (Tested Consensus)'}</span>
    </h3>
    <p class="text-xs text-slate-500 mt-0.5">Synthesized from real user long-term testing & community feedback</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Pros Column -->
    <div class="rounded-xl bg-emerald-50/60 border border-emerald-100 p-5">
      <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm mb-3">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>What We Love (Pros)</span>
      </div>
      <ul class="space-y-2.5">
        {pros.map((pro) => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 leading-snug">
            <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
            <span>{pro}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cons Column -->
    <div class="rounded-xl bg-rose-50/60 border border-rose-100 p-5">
      <div class="flex items-center gap-2 text-rose-800 font-bold text-sm mb-3">
        <svg class="w-5 h-5 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="m15 9-6 6M9 9l6 6"/>
        </svg>
        <span>Where It Falls Short (Cons)</span>
      </div>
      <ul class="space-y-2.5">
        {cons.map((con) => (
          <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 leading-snug">
            <span class="text-rose-500 font-bold shrink-0 mt-0.5">✗</span>
            <span>{con}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
