---
export interface Props {
  productName: string;
  verdict: string;
  rating: number;
  benchmarks?: {
    wobbleScoreAt45?: number;
    noiseDecibels?: number;
    realWorldPayloadLbs?: number;
    assemblyTimeMinutes?: number;
  };
  affiliateUrl: string;
}

const { productName, verdict, rating, benchmarks, affiliateUrl } = Astro.props;
---

<aside
  class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 p-6 sm:p-8 text-white shadow-elevated my-10 ring-1 ring-white/5"
  aria-label={`FindPoise Lab Verdict for ${productName}`}
  data-aeo-snippet="true"
>
  <!-- Subtle top glow accent line -->
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600"></div>

  <!-- Header badge strip -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-extrabold tracking-wider uppercase">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>FindPoise Lab Verdict</span>
    </div>
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 text-amber-300 font-extrabold text-sm backdrop-blur-sm">
      <span class="text-amber-400">★ {rating.toFixed(1)}</span>
      <span class="text-slate-500 font-normal">/</span>
      <span class="text-slate-400 text-xs font-medium">5.0 Editor Score</span>
    </div>
  </div>

  <!-- AEO Direct Answer Paragraph -->
  <div class="space-y-3">
    <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
      Bottom-Line Assessment: {productName}
    </h3>
    <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal" data-summary-text="true">
      {verdict}
    </p>
  </div>

  <!-- Benchmark Micro-Metrics (GEO Citation Targets) -->
  {benchmarks && (
    <div class="mt-6 pt-6 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {benchmarks.wobbleScoreAt45 !== undefined && (
        <div class="bg-white/[0.03] hover:bg-white/[0.06] transition-colors rounded-xl p-3.5 border border-white/5">
          <div class="text-[11px] uppercase tracking-wider font-bold text-slate-400">45" Stability</div>
          <div class="text-xl font-extrabold text-emerald-400 mt-1">{benchmarks.wobbleScoreAt45}<span class="text-xs text-slate-500 font-normal">/10</span></div>
          <div class="text-[11px] text-slate-400 mt-0.5">Deflection tested</div>
        </div>
      )}

      {benchmarks.noiseDecibels !== undefined && (
        <div class="bg-white/[0.03] hover:bg-white/[0.06] transition-colors rounded-xl p-3.5 border border-white/5">
          <div class="text-[11px] uppercase tracking-wider font-bold text-slate-400">Motor Sound</div>
          <div class="text-xl font-extrabold text-slate-100 mt-1">{benchmarks.noiseDecibels} <span class="text-xs text-slate-400 font-normal">dB</span></div>
          <div class="text-[11px] text-slate-400 mt-0.5">Quiet operation</div>
        </div>
      )}

      {benchmarks.realWorldPayloadLbs !== undefined && (
        <div class="bg-white/[0.03] hover:bg-white/[0.06] transition-colors rounded-xl p-3.5 border border-white/5">
          <div class="text-[11px] uppercase tracking-wider font-bold text-slate-400">Tested Payload</div>
          <div class="text-xl font-extrabold text-slate-100 mt-1">{benchmarks.realWorldPayloadLbs} <span class="text-xs text-slate-400 font-normal">lbs</span></div>
          <div class="text-[11px] text-slate-400 mt-0.5">Dual-motor load</div>
        </div>
      )}

      {benchmarks.assemblyTimeMinutes !== undefined && (
        <div class="bg-white/[0.03] hover:bg-white/[0.06] transition-colors rounded-xl p-3.5 border border-white/5">
          <div class="text-[11px] uppercase tracking-wider font-bold text-slate-400">Setup Time</div>
          <div class="text-xl font-extrabold text-slate-100 mt-1">~{benchmarks.assemblyTimeMinutes} <span class="text-xs text-slate-400 font-normal">min</span></div>
          <div class="text-[11px] text-slate-400 mt-0.5">Single installer</div>
        </div>
      )}
    </div>
  )}

  <!-- Footer link for compliance & conversion -->
  <div class="mt-6 pt-4 border-t border-slate-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-400">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Verified by FindPoise Hardware Testing Protocol</span>
    </span>
    <a
      href={affiliateUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="text-emerald-400 hover:text-emerald-300 font-bold underline inline-flex items-center gap-1.5 transition-colors group"
    >
      <span>View verified direct pricing</span>
      <span class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>
  </div>
</aside>

