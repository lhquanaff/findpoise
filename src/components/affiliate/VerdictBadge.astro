---
export interface Props {
  type?: 'winner' | 'value' | 'editor' | 'custom';
  text?: string;
}

const { type = 'winner', text } = Astro.props;

const config = {
  winner: {
    label: text || 'Overall Winner',
    classes: 'bg-emerald-50 text-emerald-900 border-emerald-300/80 shadow-subtle',
    icon: '🏆',
  },
  value: {
    label: text || 'Best Value Pick',
    classes: 'bg-amber-50 text-amber-950 border-amber-300/80 shadow-subtle',
    icon: '⚡',
  },
  editor: {
    label: text || "Editor's Choice",
    classes: 'bg-slate-900 text-white border-slate-700 shadow-card',
    icon: '✦',
  },
  custom: {
    label: text || 'Lab Verified',
    classes: 'bg-slate-100 text-slate-800 border-slate-200 shadow-subtle',
    icon: '✓',
  }
};

const current = config[type] || config.winner;
---

<span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-extrabold tracking-wider uppercase rounded-full border ${current.classes}`}>
  <span class="text-xs">{current.icon}</span>
  <span>{current.label}</span>
</span>

