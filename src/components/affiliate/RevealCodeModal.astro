---
export interface Props {
  brandName: string;
  discount: string;
  code: string;
  affiliateUrl: string;
  description: string;
  expiryDate?: string;
  verified?: boolean;
}

const {
  brandName,
  discount,
  code,
  affiliateUrl,
  description,
  expiryDate,
  verified = true,
} = Astro.props;

const modalId = `modal-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="relative rounded-2xl border border-slate-200/90 bg-white p-6 shadow-card hover:shadow-card-hover transition-all duration-200 ring-1 ring-black/[0.02]">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
    <div class="space-y-2">
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="px-3 py-1 text-xs font-extrabold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-300/80 rounded-lg shadow-subtle">
          {discount} OFF
        </span>
        {verified && (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Verified Active Today</span>
          </span>
        )}
      </div>
      <h4 class="text-lg font-bold text-slate-950 tracking-tight leading-snug">{description}</h4>
      <p class="text-xs text-slate-500">Applicable on official {brandName} storefront {expiryDate ? `• Expires ${expiryDate}` : ''}</p>
    </div>

    <!-- Trigger Button -->
    <div class="shrink-0">
      <button
        type="button"
        data-modal-target={modalId}
        data-coupon-code={code}
        data-affiliate-url={affiliateUrl}
        class="reveal-code-btn inline-flex items-center justify-center gap-2.5 px-5 py-3 text-xs sm:text-sm font-bold text-white bg-slate-950 hover:bg-emerald-700 rounded-xl transition-all duration-200 shadow-subtle hover:shadow-card hover:-translate-y-0.5 active:translate-y-0 w-full sm:w-auto"
      >
        <span>Reveal Code</span>
        <span class="px-2 py-0.5 rounded-md bg-white/10 text-emerald-300 font-mono text-xs border border-white/10 tracking-widest">••••••</span>
      </button>
    </div>
  </div>

  <!-- Modal Dialog -->
  <dialog id={modalId} class="fixed inset-0 z-50 rounded-2xl p-0 backdrop:bg-slate-950/70 border border-slate-200 shadow-elevated max-w-md w-full mx-auto my-auto overflow-hidden">
    <div class="p-6 sm:p-8 text-center space-y-5 bg-white">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center mx-auto shadow-subtle">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>

      <div class="space-y-1.5">
        <h3 class="text-xl font-extrabold text-slate-950 tracking-tight">Code Copied to Clipboard!</h3>
        <p class="text-xs text-slate-500">Paste this promo code at checkout on official {brandName}</p>
      </div>

      <!-- Code Box -->
      <div class="flex items-center justify-between p-4 bg-slate-50 border-2 border-dashed border-emerald-500/60 rounded-xl">
        <span class="font-mono text-xl font-black text-emerald-800 tracking-wider select-all">{code}</span>
        <button
          type="button"
          class="copy-again-btn text-xs font-bold px-3.5 py-1.5 bg-emerald-700 text-white rounded-lg hover:bg-emerald-800 transition-colors shadow-subtle"
          data-copy={code}
        >
          Copy
        </button>
      </div>

      <p class="text-xs text-slate-500 leading-relaxed">
        We opened the official {brandName} store in a new tab. If it didn't open automatically, 
        <a href={affiliateUrl} target="_blank" rel="nofollow noopener sponsored" class="text-emerald-700 underline font-bold">click here</a>.
      </p>

      <div class="pt-2">
        <button
          type="button"
          class="close-modal-btn w-full py-2.5 text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-950 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
        >
          Close Window
        </button>
      </div>
    </div>
  </dialog>
</div>


<script>
  function setupRevealModals() {
    const buttons = document.querySelectorAll('.reveal-code-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-modal-target');
        const code = btn.getAttribute('data-coupon-code');
        const url = btn.getAttribute('data-affiliate-url');
        const dialog = document.getElementById(modalId!) as HTMLDialogElement | null;

        if (code) {
          navigator.clipboard.writeText(code).catch(() => {});
        }

        if (url) {
          window.open(url, '_blank', 'noopener,noreferrer');
        }

        if (dialog) {
          dialog.showModal();
        }
      });
    });

    document.querySelectorAll('.close-modal-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const dialog = (e.target as HTMLElement).closest('dialog');
        if (dialog) dialog.close();
      });
    });

    document.querySelectorAll('.copy-again-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const code = target.getAttribute('data-copy');
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            target.textContent = 'Copied!';
            setTimeout(() => (target.textContent = 'Copy'), 2000);
          });
        }
      });
    });
  }

  // Setup on page load and view transitions
  setupRevealModals();
  document.addEventListener('astro:page-load', setupRevealModals);
</script>
