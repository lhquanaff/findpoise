---
export interface Props {
  productName: string;
  brand: string;
  price: number;
  originalPrice?: number;
  rating: number;
  affiliateUrl: string;
  retailer?: string;
  badge?: string;
  couponCode?: string;
}

const {
  productName,
  brand,
  price,
  originalPrice,
  rating,
  affiliateUrl,
  retailer = 'Official Store',
  badge = "Editor's Choice",
  couponCode,
} = Astro.props;

const stars = Array.from({ length: 5 }, (_, i) => i < Math.floor(rating));
---

<div class="my-8 rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-card hover:shadow-card-hover transition-all duration-300 ring-1 ring-black/[0.02]">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
    <div class="space-y-2.5">
      <div class="flex items-center gap-2.5 flex-wrap">
        {badge && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-extrabold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-300/80 rounded-full shadow-subtle">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>{badge}</span>
          </span>
        )}
        <span class="text-xs uppercase font-bold tracking-wider text-slate-500">{brand}</span>
      </div>

      <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight leading-snug">
        {productName}
      </h3>
      
      <!-- Ratings & Verification -->
      <div class="flex items-center gap-2.5 text-xs">
        <div class="flex text-amber-400 text-sm">
          {stars.map((filled) => (
            <span>{filled ? '★' : '☆'}</span>
          ))}
        </div>
        <span class="font-extrabold text-slate-900">{rating.toFixed(1)} / 5.0</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600 font-medium flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Hardware Tested
        </span>
      </div>

      {couponCode && (
        <div class="inline-flex items-center gap-2 mt-1 px-3 py-1.5 rounded-xl bg-amber-50/80 border border-amber-200/80 text-amber-950 text-xs font-semibold">
          <span>🏷️ Verified Code:</span>
          <code class="font-mono font-bold text-amber-900 bg-amber-200/60 px-2 py-0.5 rounded-md select-all">{couponCode}</code>
        </div>
      )}
    </div>

    <!-- Pricing & Button -->
    <div class="flex flex-col sm:items-end justify-center gap-3 shrink-0 pt-5 sm:pt-0 border-t sm:border-t-0 border-slate-100">
      <div class="sm:text-right">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Lowest Verified Direct Price</div>
        <div class="flex items-baseline sm:justify-end gap-2.5">
          <span class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight">${price.toFixed(2)}</span>
          {originalPrice && (
            <span class="text-base text-slate-400 line-through">${originalPrice.toFixed(2)}</span>
          )}
        </div>
      </div>

      <a
        href={affiliateUrl}
        target="_blank"
        rel="nofollow noopener sponsored"
        class="btn-affiliate w-full sm:w-auto text-center group"
      >
        <span>Check Price on {retailer}</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      
      <div class="text-[11px] text-slate-600 sm:text-right flex items-center gap-1.5 justify-start sm:justify-end">
        <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Direct fulfillment & official manufacturer warranty</span>
      </div>
    </div>
  </div>
</div>

