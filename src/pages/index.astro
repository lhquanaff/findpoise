---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import RevealCodeModal from '@/components/affiliate/RevealCodeModal.astro';

const reviews = await getCollection('reviews');
const comparisons = await getCollection('comparisons');
const coupons = await getCollection('coupons');
const guides = await getCollection('guides');
---

<BaseLayout
  title="FindPoise | Workstation Ergonomics & Standing Desk Reviews"
  description="Data-driven, spec-tested reviews and head-to-head comparisons for standing desks, ergonomic office chairs, and modern workstation accessories."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50 to-slate-100 py-16 sm:py-24 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold tracking-wider uppercase shadow-sm">
        <span>✨ 100% Spec-Driven & Community-Verified Testing</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight max-w-4xl mx-auto leading-[1.1]">
        Elevate Your Posture. <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700">Find Your Poise.</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        We cut through marketing hype with side-by-side stability tests, motor decibel ratings, and long-term ergonomic consensus for remote professionals.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href="/compare" class="btn-affiliate">
          <span>Explore Head-to-Head Comparisons</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="/reviews" class="btn-secondary">
          Browse Standing Desk Reviews
        </a>
      </div>

      <!-- Trust stats -->
      <div class="pt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto border-t border-slate-200/80 text-left">
        <div class="p-3">
          <div class="text-2xl font-extrabold text-slate-900">45+ In</div>
          <div class="text-xs text-slate-500 font-medium">Wobble Tested Elevation</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-extrabold text-slate-900">&lt; 48 dB</div>
          <div class="text-xs text-slate-500 font-medium">Strict Noise Benchmarks</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-extrabold text-slate-900">15 Years</div>
          <div class="text-xs text-slate-500 font-medium">Warranty Verification</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-extrabold text-slate-900">Zero Fluff</div>
          <div class="text-xs text-slate-500 font-medium">FTC Compliant & Direct</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Comparisons (Versus Section) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Versus Matrix</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Head-to-Head Showdowns</h2>
      </div>
      <a href="/compare" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors hidden sm:flex items-center gap-1">
        <span>View all comparisons</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {comparisons.map((item) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card hover:shadow-card-hover transition-all space-y-4">
          <div class="flex items-center justify-between text-xs">
            <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold uppercase">
              Winner: {item.data.winner}
            </span>
            <span class="text-slate-400">{item.data.category}</span>
          </div>

          <h3 class="text-xl font-extrabold text-slate-900 leading-snug">
            <a href={`/compare/${item.id}`} class="hover:text-emerald-600 transition-colors">
              {item.data.title}
            </a>
          </h3>

          <p class="text-sm text-slate-600 line-clamp-2 leading-relaxed">
            {item.data.description}
          </p>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="text-xs font-semibold text-slate-500">
              {item.data.productA.name} <span class="text-slate-400">vs</span> {item.data.productB.name}
            </div>
            <a href={`/compare/${item.id}`} class="text-xs font-bold text-slate-900 hover:text-emerald-600 inline-flex items-center gap-1">
              Read Breakdown →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Latest In-Depth Reviews -->
  <section class="bg-slate-100/70 border-y border-slate-200/80 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Spec Evaluations</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Recent Product Reviews</h2>
        </div>
        <a href="/reviews" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors hidden sm:flex items-center gap-1">
          <span>All reviews</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {reviews.map((rev) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-card transition-all flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{rev.data.brand}</span>
                <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">
                  ★ {rev.data.rating.toFixed(1)}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 leading-snug">
                <a href={`/reviews/${rev.id}`} class="hover:text-emerald-600 transition-colors">
                  {rev.data.productName}
                </a>
              </h3>
              <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                {rev.data.verdict}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-xs text-slate-400">Starting at</span>
                <div class="text-lg font-extrabold text-slate-900">${rev.data.price.toFixed(2)}</div>
              </div>
              <a
                href={`/reviews/${rev.id}`}
                class="px-3.5 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-emerald-600 rounded-lg transition-colors"
              >
                Read Review
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Verified Brand Coupons (Bottom of Funnel) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-8">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Save On Workstation Gear</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Verified Exclusive Coupons</h2>
      <p class="text-sm text-slate-600 mt-1">Codes tested and verified daily for checkout on official manufacturer stores.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {coupons.map((c) => (
        <RevealCodeModal
          brandName={c.data.brand}
          discount={c.data.discount}
          code={c.data.code}
          affiliateUrl={c.data.affiliateUrl}
          description={c.data.description}
          expiryDate={c.data.expiryDate}
          verified={c.data.verified}
        />
      ))}
    </div>
  </section>

  <!-- Ergonomic Guides & Insights -->
  <section class="bg-slate-100/70 border-t border-slate-200/80 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Knowledge Base</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Ergonomic Buying Guides</h2>
        </div>
        <a href="/guides" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors hidden sm:flex items-center gap-1">
          <span>All guides</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {guides.map((g) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-card transition-all space-y-3">
            <span class="text-xs font-bold uppercase text-emerald-600">{g.data.category}</span>
            <h3 class="text-xl font-bold text-slate-900">
              <a href={`/guides/${g.id}`} class="hover:text-emerald-600 transition-colors">
                {g.data.title}
              </a>
            </h3>
            <p class="text-sm text-slate-600 line-clamp-2">{g.data.description}</p>
            <div class="pt-2 text-xs font-semibold text-slate-500">
              By {g.data.author}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
