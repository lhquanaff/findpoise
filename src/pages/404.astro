---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Page Not Found | FindPoise Lab"
  description="Sorry, the ergonomic review or comparison you are looking for does not exist."
>
  <div class="max-w-xl mx-auto px-4 py-28 text-center space-y-6">
    <div class="w-16 h-16 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-center mx-auto text-2xl font-black shadow-subtle">
      404
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-950 tracking-tight">Article Not Found</h1>
    <p class="text-base text-slate-600 leading-relaxed font-normal">
      The ergonomic desk or comparison you are looking for has been updated, archived, or retired. Explore our top reviews or head back to the laboratory homepage.
    </p>
    <div class="pt-4 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-affiliate">Return to Home</a>
      <a href="/compare" class="btn-secondary">Explore Versus Matrix</a>
    </div>
  </div>
</BaseLayout>

