---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Page Not Found"
  description="Sorry, the ergonomic review or comparison you are looking for does not exist."
>
  <div class="max-w-xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-2xl font-extrabold">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Post Not Found</h1>
    <p class="text-slate-600 leading-relaxed">
      The ergonomic desk or comparison you are looking for has been moved or retired. Explore our top reviews or head back to home.
    </p>
    <div class="pt-4 flex justify-center gap-4">
      <a href="/" class="btn-affiliate">Return to Home</a>
      <a href="/compare" class="btn-secondary">View Comparisons</a>
    </div>
  </div>
</BaseLayout>
