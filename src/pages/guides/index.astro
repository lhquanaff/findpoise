---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
---

<BaseLayout
  title="Ergonomic Workstation Setup & Buying Guides | FindPoise Lab"
  description="Expert guides on desk height calculations, lumbar posture adjustments, monitor arm positioning, and healthy remote work habits."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Buying Guides', url: '/guides' }]} />

    <header class="my-8 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-300/80 text-xs font-bold tracking-wider uppercase shadow-subtle">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Biomechanics & Workstation Geometry</span>
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
        Ergonomic Guides
      </h1>
      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
        Deep-dive educational guides grounded in spinal biomechanics, desk height formulas, and workstation setup checklists.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 my-10">
      {guides.map((g) => (
        <article class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-card hover:shadow-card-hover transition-all duration-300 space-y-4 ring-1 ring-black/[0.02]">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-700">{g.data.category}</div>
          <h2 class="text-2xl font-extrabold text-slate-950 leading-snug tracking-tight">
            <a href={`/guides/${g.id}`} class="hover:text-emerald-700 transition-colors">
              {g.data.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{g.data.description}</p>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">By {g.data.author}</span>
            <a href={`/guides/${g.id}`} class="font-bold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group">
              <span>Read Guide</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
