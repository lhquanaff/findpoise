---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
---

<BaseLayout
  title="Ergonomic Workstation Setup & Buying Guides"
  description="Expert guides on desk height calculations, lumbar posture adjustments, monitor arm positioning, and healthy remote work habits."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Buying Guides', url: '/guides' }]} />

    <header class="my-6 max-w-3xl space-y-3">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">Ergonomic Guides</h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Deep-dive educational guides grounded in biomechanics, spine ergonomics, and workstation geometry.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-10">
      {guides.map((g) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm hover:shadow-card transition-all space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-600">{g.data.category}</div>
          <h2 class="text-2xl font-extrabold text-slate-900 leading-snug">
            <a href={`/guides/${g.id}`} class="hover:text-emerald-600 transition-colors">
              {g.data.title}
            </a>
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">{g.data.description}</p>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-400">By {g.data.author}</span>
            <a href={`/guides/${g.id}`} class="text-xs font-bold text-slate-900 hover:text-emerald-600">
              Read Guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
