---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const comparisons = await getCollection('comparisons');
---

<BaseLayout
  title="Ergonomic Gear Head-to-Head Comparisons"
  description="Direct versus battles between leading standing desks and ergonomic chairs. Clear winners, spec breakdowns, and value picks."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Comparisons', url: '/compare' }]} />

    <header class="my-6 max-w-3xl space-y-3">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">Head-to-Head Comparisons</h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Can't decide between two top-tier models? We put competing ergonomic equipment through head-to-head testing to reveal the definitive winner.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-10">
      {comparisons.map((item) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-card transition-all space-y-4">
          <div class="flex items-center justify-between text-xs">
            <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold uppercase">
              Winner: {item.data.winner}
            </span>
            <span class="text-slate-400">{item.data.category}</span>
          </div>

          <h2 class="text-xl font-extrabold text-slate-900 leading-snug">
            <a href={`/compare/${item.id}`} class="hover:text-emerald-600 transition-colors">
              {item.data.title}
            </a>
          </h2>

          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
            {item.data.description}
          </p>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="text-xs font-semibold text-slate-500">
              {item.data.productA.name} <span class="text-slate-400">vs</span> {item.data.productB.name}
            </div>
            <a href={`/compare/${item.id}`} class="text-xs font-bold text-slate-900 hover:text-emerald-600 inline-flex items-center gap-1">
              Read Showdown →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
