---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const comparisons = await getCollection('comparisons');
---

<BaseLayout
  title="Ergonomic Gear Head-to-Head Comparisons | FindPoise Lab"
  description="Direct versus battles between leading standing desks and ergonomic chairs. Clear winners, spec breakdowns, and value picks."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Comparisons', url: '/compare' }]} />

    <header class="my-8 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-300/80 text-xs font-bold tracking-wider uppercase shadow-subtle">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Versus Matrix Showdowns</span>
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
        Head-to-Head Comparisons
      </h1>
      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
        Can't decide between two top-tier ergonomic workstations? We pit competing models against each other across stability, acoustics, and daily durability to determine the definitive winner.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 my-10">
      {comparisons.map((item) => (
        <article class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-card hover:shadow-card-hover transition-all duration-300 space-y-4 ring-1 ring-black/[0.02]">
          <div class="flex items-center justify-between text-xs">
            <span class="badge-winner">
              Winner: {item.data.winner}
            </span>
            <span class="text-slate-400 font-semibold uppercase tracking-wider text-[11px]">{item.data.category}</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-950 leading-snug tracking-tight">
            <a href={`/compare/${item.id}`} class="hover:text-emerald-700 transition-colors">
              {item.data.title}
            </a>
          </h2>

          <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
            {item.data.description}
          </p>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="text-xs font-semibold text-slate-500">
              <span class="text-slate-900 font-bold">{item.data.productA.name}</span>
              <span class="text-slate-400 mx-1">vs</span>
              <span class="text-slate-900 font-bold">{item.data.productB.name}</span>
            </div>
            <a href={`/compare/${item.id}`} class="text-xs font-bold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group">
              <span>Read Showdown</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
