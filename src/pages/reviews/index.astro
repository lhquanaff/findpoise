---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const reviews = await getCollection('reviews');
---

<BaseLayout
  title="Standing Desk & Ergonomic Chair Reviews | FindPoise Lab"
  description="Spec-by-spec evaluations of leading ergonomic office equipment. Compare weight ratings, stability benchmarks, and motor decibels."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Reviews', url: '/reviews' }]} />

    <header class="my-8 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-300/80 text-xs font-bold tracking-wider uppercase shadow-subtle">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        <span>Hardware Lab Evaluations</span>
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
        Product Reviews
      </h1>
      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
        Every ergonomic desk and chair in our lab is scrutinized for wobble resistance, manufacturing tolerances, motor noise, and long-term owner durability.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 my-10">
      {reviews.map((rev) => (
        <article class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between space-y-5 ring-1 ring-black/[0.02]">
          <div class="space-y-3.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold uppercase tracking-wider text-slate-500">{rev.data.brand}</span>
              <span class="font-extrabold text-amber-900 bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-md">
                ★ {rev.data.rating.toFixed(1)}
              </span>
            </div>
            
            <h2 class="text-xl font-extrabold text-slate-950 leading-snug tracking-tight">
              <a href={`/reviews/${rev.id}`} class="hover:text-emerald-700 transition-colors">
                {rev.data.productName}
              </a>
            </h2>
            
            <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
              {rev.data.verdict}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[11px] font-medium text-slate-400">Starting at</span>
              <div class="text-xl font-extrabold text-slate-950">${rev.data.price.toFixed(2)}</div>
            </div>
            <a
              href={`/reviews/${rev.id}`}
              class="px-4 py-2.5 text-xs font-bold text-white bg-slate-950 hover:bg-emerald-700 rounded-xl transition-all shadow-subtle hover:shadow-card hover:-translate-y-0.5"
            >
              Read Review
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
