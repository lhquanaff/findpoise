---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const reviews = await getCollection('reviews');
---

<BaseLayout
  title="Standing Desk & Ergonomic Chair Reviews"
  description="Spec-by-spec evaluations of leading ergonomic office equipment. Compare weight ratings, stability benchmarks, and motor decibels."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <Breadcrumbs items={[{ name: 'Reviews', url: '/reviews' }]} />

    <header class="my-6 max-w-3xl space-y-3">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">Product Reviews</h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Every product reviewed on FindPoise is scrutinized for wobble resistance, build tolerances, motor sound levels, and real-world durability.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 my-10">
      {reviews.map((rev) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-card transition-all flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold uppercase tracking-wider text-slate-500">{rev.data.brand}</span>
              <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">
                ★ {rev.data.rating.toFixed(1)}
              </span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 leading-snug">
              <a href={`/reviews/${rev.id}`} class="hover:text-emerald-600 transition-colors">
                {rev.data.productName}
              </a>
            </h2>
            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
              {rev.data.verdict}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[11px] text-slate-400">Starting at</span>
              <div class="text-lg font-extrabold text-slate-900">${rev.data.price.toFixed(2)}</div>
            </div>
            <a
              href={`/reviews/${rev.id}`}
              class="px-4 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-emerald-600 rounded-lg transition-colors"
            >
              Read Review
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
